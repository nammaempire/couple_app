rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isMemberOf(coupleId) {
      return request.auth != null &&
        request.auth.uid in
          firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.memberIds;
    }

    // True when the signed-in user shares a couple with [userId].
    function isPartnerOf(userId) {
      return request.auth != null &&
        isMemberOf(
          firestore.get(/databases/(default)/documents/users/$(userId)).data.coupleId
        );
    }

    function isImageUnder(megabytes) {
      return request.resource.size < megabytes * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /couples/{coupleId}/photos/{photoId} {
      allow read: if isMemberOf(coupleId);

      allow write: if isMemberOf(coupleId) && isImageUnder(15);

      allow delete: if isMemberOf(coupleId);
    }

    // Chat videos. The app limits them to 3 minutes; 100 MB is the hard cap.
    match /couples/{coupleId}/videos/{videoId} {
      allow read: if isMemberOf(coupleId);
      allow write: if isMemberOf(coupleId) &&
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('video/.*');
      allow delete: if isMemberOf(coupleId);
    }

    // Voice messages (AAC in .m4a, recorded for up to 5 minutes).
    match /couples/{coupleId}/voice/{voiceId} {
      allow read: if isMemberOf(coupleId);
      allow write: if isMemberOf(coupleId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
      allow delete: if isMemberOf(coupleId);
    }

    // Memory photos, video thumbnails and videos.
    match /couples/{coupleId}/memories/{fileId} {
      allow read: if isMemberOf(coupleId);
      allow create, update: if isMemberOf(coupleId) &&
        request.resource.size < 100 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('video/.*'));
      allow delete: if isMemberOf(coupleId);
    }

    // Voice love letters. Only the sender may read the file directly; the
    // recipient plays it through the link kept in the sealed note, which
    // they can only read once the note is delivered.
    match /couples/{coupleId}/notes/{fileId} {
      allow read: if isMemberOf(coupleId) &&
        resource.metadata.senderId == request.auth.uid;
      allow create: if isMemberOf(coupleId) &&
        request.resource.metadata.senderId == request.auth.uid &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
      allow delete: if isMemberOf(coupleId) &&
        resource.metadata.senderId == request.auth.uid;
    }

    // Shared couple picture, set during onboarding or later.
    match /couples/{coupleId}/profile/{photoId} {
      allow read: if isMemberOf(coupleId);
      allow write: if isMemberOf(coupleId) && isImageUnder(10);
      allow delete: if isMemberOf(coupleId);
    }

    // Chat background photos both partners see.
    match /couples/{coupleId}/backgrounds/{fileId} {
      allow read: if isMemberOf(coupleId);
      allow create: if isMemberOf(coupleId) && isImageUnder(10);
      allow delete: if isMemberOf(coupleId);
    }

    // Memory books: PDFs made on a phone, shared with the partner.
    match /couples/{coupleId}/books/{fileId} {
      allow read, delete: if isMemberOf(coupleId);
      allow create: if isMemberOf(coupleId) &&
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
    }

    // Vault files: photos and thumbnails encrypted on the phone. The
    // server only stores opaque bytes.
    match /couples/{coupleId}/vault/{fileId} {
      allow read: if isMemberOf(coupleId);
      allow create: if isMemberOf(coupleId) &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType == 'application/octet-stream';
      allow delete: if isMemberOf(coupleId);
    }

    // A personal chat background: only its owner ever sees it.
    match /users/{userId}/backgrounds/{fileId} {
      allow read, delete: if request.auth != null &&
        request.auth.uid == userId;
      allow create: if request.auth != null &&
        request.auth.uid == userId && isImageUnder(10);
    }

    // A user's own profile picture. Their partner can see it too.
    match /users/{userId}/profile/{photoId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isPartnerOf(userId));
      allow write: if request.auth != null &&
        request.auth.uid == userId && isImageUnder(10);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

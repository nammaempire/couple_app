{
  "name": "couple-app-firestore-tests",
  "private": true,
  "description": "Security-rules tests for firestore.rules and storage.rules, run against the Firebase emulators.",
  "scripts": {
    "pretest": "cp ../firestore.rules ../storage.rules .",
    "test": "firebase emulators:exec --only firestore,storage --project demo-couple \"mocha --timeout 20000 'test/*.test.js'\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^14.27.0",
    "mocha": "^12.0.3"
  }
}

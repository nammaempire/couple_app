rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function coupleDoc(coupleId) {
      return /databases/$(database)/documents/couples/$(coupleId);
    }

    function inviteDoc(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    function isMemberOf(coupleId) {
      return signedIn() &&
        request.auth.uid in get(coupleDoc(coupleId)).data.memberIds;
    }

    // Membership as it will be once the current write/batch/transaction
    // commits. Used when a couple and a user link are written together.
    function isMemberAfter(coupleId) {
      return signedIn() &&
        request.auth.uid in getAfter(coupleDoc(coupleId)).data.memberIds;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---- Users -----------------------------------------------------------

    match /users/{userId} {
      // Avatar fields, when present, keep the shape the app reads. The
      // avatar's parts aren't listed, so newer app versions can add more.
      function avatarOk() {
        let d = request.resource.data;
        return (!('avatar' in d) || d.avatar == null ||
                (d.avatar is map && d.avatar.size() <= 24)) &&
          (!('avatarAsPhoto' in d) || d.avatarAsPhoto == null ||
           d.avatarAsPhoto is bool);
      }

      // You can read your own profile, and your partner's once you share a
      // couple. Nobody else can see names, photos or emails.
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (resource.data.get('coupleId', null) != null &&
         isMemberOf(resource.data.coupleId))
      );

      // A phone number on the profile is always the one this account
      // verified by SMS. `mutePartner` is a plain switch. The server writes
      // `pairingEndedAt` / `pairingEndedHow` when a pairing ends; the person
      // may only clear them.
      function profileExtrasOk(phoneChanged) {
        let d = request.resource.data;
        return (!phoneChanged || !('phone' in d) || d.phone == null ||
                d.phone == request.auth.token.get('phone_number', null)) &&
          (!('mutePartner' in d) || d.mutePartner is bool) &&
          (!('blockNewPhoneUntil' in d) || d.blockNewPhoneUntil == null ||
           d.blockNewPhoneUntil is timestamp);
      }

      function pairingEndedUntouched() {
        return (!('pairingEndedAt' in changedKeys()) ||
                !('pairingEndedAt' in request.resource.data)) &&
          (!('pairingEndedHow' in changedKeys()) ||
           !('pairingEndedHow' in request.resource.data));
      }

      // New profiles start unpaired.
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.get('coupleId', null) == null &&
        !('pairingEndedAt' in request.resource.data) &&
        avatarOk() && profileExtrasOk(true);

      // You may edit your own profile. `coupleId` can only point at a couple
      // you are actually a member of (after this write), or be cleared.
      allow update: if signedIn() &&
        request.auth.uid == userId && avatarOk() &&
        profileExtrasOk('phone' in changedKeys()) &&
        pairingEndedUntouched() && (
          !('coupleId' in changedKeys()) ||
          request.resource.data.coupleId == null ||
          isMemberAfter(request.resource.data.coupleId)
        );

      allow delete: if false;

      // Phones that passed the new-phone check (recycled-number
      // protection). The owner manages them; the partner may see the list.
      match /devices/{deviceId} {
        allow read: if signedIn() && (request.auth.uid == userId ||
          (get(/databases/$(database)/documents/users/$(userId)).data
             .get('coupleId', null) != null &&
           isMemberOf(get(/databases/$(database)/documents/users/$(userId))
             .data.coupleId)));
        allow create: if signedIn() && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['name', 'addedAt',
            'lastSeenAt', 'via']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() <= 60 &&
          request.resource.data.addedAt == request.time &&
          request.resource.data.lastSeenAt == request.time &&
          request.resource.data.via in ['first', 'partner', 'email', 'wait'];
        allow update: if signedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastSeenAt']) &&
          request.resource.data.lastSeenAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      // Security notices for the account owner. Their partner may post the
      // one that says they turned down a sign-in on a new phone.
      match /securityEvents/{eventId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['type', 'deviceName', 'at']) &&
          request.resource.data.deviceName is string &&
          request.resource.data.deviceName.size() <= 60 &&
          request.resource.data.at == request.time && (
            (request.auth.uid == userId &&
             request.resource.data.type in
               ['newPhoneRejected', 'newPhoneWaiting', 'newPhoneApproved']) ||
            (request.resource.data.type == 'newPhoneRejected' &&
             get(/databases/$(database)/documents/users/$(userId)).data
               .get('coupleId', null) != null &&
             isMemberOf(get(/databases/$(database)/documents/users/$(userId))
               .data.coupleId)));
        allow update: if false;
      }
    }

    // ---- Phone numbers and pairing by number -----------------------------

    // phoneIndex/{+919876543210}: which account a verified number belongs
    // to, so a partner can be found by number. One doc can be fetched at a
    // time but never listed. Only the account that verified the number by
    // SMS may claim it (a recycled number moves to its new owner).
    match /phoneIndex/{e164} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() &&
        request.auth.token.get('phone_number', null) == e164 &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // pairRequests/{id}: "Asha wants to pair with you". The sender offers
    // their couple of one and its invite code; the receiver accepts by
    // joining with that code (the invite rules above), then marks it.
    match /pairRequests/{requestId} {
      function e164OrEmpty(v) {
        return v is string && (v == '' || v.matches('^[+][1-9][0-9]{6,14}$'));
      }

      allow read: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['fromUid', 'fromName',
          'fromPhone', 'toUid', 'toPhone', 'coupleId', 'inviteCode',
          'status', 'createdAt']) &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.fromName is string &&
        request.resource.data.fromName.size() <= 60 &&
        e164OrEmpty(request.resource.data.fromPhone) &&
        e164OrEmpty(request.resource.data.toPhone) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        get(coupleDoc(request.resource.data.coupleId)).data.memberIds ==
          [request.auth.uid] &&
        get(coupleDoc(request.resource.data.coupleId)).data.inviteCode ==
          request.resource.data.inviteCode;
      // Only the status moves, once, out of 'pending': the receiver
      // accepts or declines, the sender cancels.
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']) &&
        resource.data.status == 'pending' && (
          (request.auth.uid == resource.data.toUid &&
           request.resource.data.status in ['accepted', 'declined']) ||
          (request.auth.uid == resource.data.fromUid &&
           request.resource.data.status == 'cancelled'));
      allow delete: if signedIn() &&
        resource.data.fromUid == request.auth.uid;
    }

    // purchases/{hash}: written only by the server when it verifies a
    // Google Play purchase.
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }

    // ---- Invites ---------------------------------------------------------

    // One document per invite code: invites/{code}. Codes can be looked up
    // one at a time (get) but never listed, so they cannot be enumerated.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      // Created alongside (or for) a couple you belong to, whose invite code
      // is this document's id.
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.used == false &&
        isMemberAfter(request.resource.data.coupleId) &&
        getAfter(coupleDoc(request.resource.data.coupleId)).data.inviteCode == code;

      // Accepting: the joiner marks an unused invite as used by themselves,
      // in the same transaction that adds them to the couple.
      allow update: if signedIn() &&
        resource.data.used == false &&
        request.resource.data.used == true &&
        request.resource.data.usedBy == request.auth.uid &&
        changedKeys().hasOnly(['used', 'usedBy', 'usedAt']) &&
        isMemberAfter(resource.data.coupleId);

      // The creator may withdraw their invite.
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ---- Couples ---------------------------------------------------------

    match /couples/{coupleId} {
      // Only the two members can read the couple, which holds the last
      // message preview, dates and nicknames.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn() &&
        request.resource.data.memberIds == [request.auth.uid] &&
        request.resource.data.inviteCode is string;

      allow update: if signedIn() && (
        // Members edit shared details, but cannot add anyone. The only
        // membership change a member can make is removing themselves.
        (request.auth.uid in resource.data.memberIds && (
          !('memberIds' in changedKeys()) ||
          request.resource.data.memberIds ==
            resource.data.memberIds.removeAll([request.auth.uid])
        ) &&
        // Clearing the chat for both is stamped with the server's time.
        (!('chatClearedAt' in changedKeys()) ||
         request.resource.data.chatClearedAt == request.time) &&
        (!('chatClearedBy' in changedKeys()) ||
         request.resource.data.chatClearedBy == request.auth.uid) &&
        // A shared "no screenshots in our chat" switch.
        (!('blockScreenshots' in changedKeys()) ||
         request.resource.data.blockScreenshots is bool) &&
        separationOk() &&
        // `ending` is the server's own lock while it deletes a couple.
        !('ending' in changedKeys()) &&
        // Premium is granted only by the server after it verifies a
        // purchase. A Memory book credit can only be spent: down by one,
        // never below zero (the book itself is checked under /books).
        !('premium' in changedKeys()) &&
        (!('bookCredits' in changedKeys()) ||
         (request.resource.data.bookCredits is int &&
          request.resource.data.bookCredits ==
            resource.data.get('bookCredits', 0) - 1 &&
          request.resource.data.bookCredits >= 0))) ||

        // Joining: a non-member adds only themselves to a couple of one,
        // and only by consuming this couple's invite in the same transaction.
        (!(request.auth.uid in resource.data.memberIds) &&
         resource.data.memberIds.size() == 1 &&
         request.resource.data.memberIds ==
           resource.data.memberIds.concat([request.auth.uid]) &&
         changedKeys().hasOnly(['memberIds', 'activatedAt']) &&
         get(inviteDoc(resource.data.inviteCode)).data.coupleId == coupleId &&
         get(inviteDoc(resource.data.inviteCode)).data.used == false &&
         getAfter(inviteDoc(resource.data.inviteCode)).data.usedBy ==
           request.auth.uid)
      );

      // Ending a pairing (`separation`). Either partner asks; it takes
      // effect 14 days later, or 7 days after the other agrees, whichever is
      // sooner. The other partner may agree or decline but can never stop
      // it; only the one who asked can cancel. The server deletes everything
      // once `effectiveAt` has passed (functions/).
      function within(t, days) {
        return t is timestamp &&
          t > request.time + duration.value(days * 1440 - 10, 'm') &&
          t < request.time + duration.value(days * 1440 + 10, 'm');
      }

      function separationOk() {
        let before = resource.data.get('separation', null);
        let after = request.resource.data.get('separation', null);
        let me = request.auth.uid;
        return !('separation' in changedKeys()) || (
          // Asking.
          (before == null && after != null &&
           after.keys().hasOnly(['requestedBy', 'requestedAt', 'status',
             'agreedAt', 'declinedAt', 'effectiveAt']) &&
           after.requestedBy == me && after.requestedAt == request.time &&
           after.status == 'requested' &&
           after.agreedAt == null && after.declinedAt == null &&
           within(after.effectiveAt, 14)) ||
          // Changing their mind: only the one who asked.
          (before != null && after == null && before.requestedBy == me) ||
          // The other partner agrees (also after declining): it ends 7 days
          // from now, or on the original date if that is sooner.
          (before != null && after != null && before.requestedBy != me &&
           before.status in ['requested', 'declined'] &&
           after.status == 'agreed' && after.agreedAt == request.time &&
           after.requestedBy == before.requestedBy &&
           after.requestedAt == before.requestedAt &&
           after.declinedAt == before.declinedAt &&
           after.keys().hasOnly(['requestedBy', 'requestedAt', 'status',
             'agreedAt', 'declinedAt', 'effectiveAt']) &&
           (after.effectiveAt == before.effectiveAt ||
            (within(after.effectiveAt, 7) &&
             after.effectiveAt <= before.effectiveAt))) ||
          // The other partner declines: nothing else changes.
          (before != null && after != null && before.requestedBy != me &&
           before.status == 'requested' &&
           after.status == 'declined' && after.declinedAt == request.time &&
           after.requestedBy == before.requestedBy &&
           after.requestedAt == before.requestedAt &&
           after.agreedAt == before.agreedAt &&
           after.effectiveAt == before.effectiveAt &&
           after.keys().hasOnly(['requestedBy', 'requestedAt', 'status',
             'agreedAt', 'declinedAt', 'effectiveAt'])));
      }

      // A couple still waiting for a partner can be cancelled by its creator.
      allow delete: if signedIn() &&
        resource.data.memberIds == [request.auth.uid];

      match /messages/{messageId} {
        allow read: if isMemberOf(coupleId);

        // Couple stickers carry the quote as text (so older app versions
        // still show it) and a small `sticker` map naming the scene.
        function stickerOk() {
          let d = request.resource.data;
          return d.get('type', '') != 'sticker' || (
            d.text is string && d.text.size() <= 400 &&
            d.sticker is map &&
            d.sticker.get('id', '') is string &&
            d.sticker.get('id', '').size() > 0 &&
            d.sticker.get('id', '').size() <= 64
          );
        }

        // System lines (chat cleared, screenshot taken, screenshot blocking
        // switched) are short text only: no media, replies or reactions.
        function systemOk() {
          let d = request.resource.data;
          return !(d.get('type', '') in
                   ['chatCleared', 'screenshot', 'screenshotBlock']) || (
            d.text is string && d.text.size() <= 200 &&
            d.get('imageUrl', null) == null &&
            d.get('mediaUrl', null) == null &&
            d.get('replyTo', null) == null &&
            d.get('reactions', {}).size() == 0
          );
        }

        allow create: if isMemberOf(coupleId) &&
          request.resource.data.senderId == request.auth.uid &&
          stickerOk() && systemOk();

        // Either partner may mark seen, react, or pin — but never change
        // what a message says or who sent it. The sender may delete their
        // own message. "Clear chat for both" first stamps the couple's
        // `chatClearedAt` (server time), then either partner may delete any
        // message sent up to that moment.
        allow update: if isMemberOf(coupleId) &&
          changedKeys().hasOnly(['seen', 'reactions', 'pinned', 'pinnedAt']) &&
          (!(resource.data.get('type', '') in
             ['chatCleared', 'screenshot', 'screenshotBlock']) ||
           changedKeys().hasOnly(['seen']));
        allow delete: if isMemberOf(coupleId) && (
          resource.data.senderId == request.auth.uid ||
          (resource.data.get('sentAt', null) is timestamp &&
           get(coupleDoc(coupleId)).data.get('chatClearedAt', null)
             is timestamp &&
           resource.data.sentAt <=
             get(coupleDoc(coupleId)).data.chatClearedAt));
      }

      // Mood check-ins: one document per partner, and you own only your own.
      match /moods/{userId} {
        allow read: if isMemberOf(coupleId);
        allow write: if isMemberOf(coupleId) && request.auth.uid == userId;
      }

      // Daily questions: one document per day holding both answers. Either
      // partner may create or merge into it; nobody may delete the record.
      match /dailyQuestions/{dateKey} {
        allow read: if isMemberOf(coupleId);
        allow create, update: if isMemberOf(coupleId);
        allow delete: if false;
      }

      // Call signalling. A single `current` document both partners read and
      // write: the caller sets it ringing, the callee accepts or declines,
      // and either may end it.
      match /call/{callId} {
        allow read: if isMemberOf(coupleId);
        allow create: if isMemberOf(coupleId) &&
          request.resource.data.callerId == request.auth.uid;
        allow update, delete: if isMemberOf(coupleId);
      }

      // Memories: shared by both. Either partner may edit one, but it stays
      // credited to whoever added it, and only they can delete it.
      match /memories/{memoryId} {
        allow read: if isMemberOf(coupleId);
        allow create: if isMemberOf(coupleId) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isMemberOf(coupleId) &&
          request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMemberOf(coupleId) &&
          resource.data.createdBy == request.auth.uid;
      }

      // Calendar events. A private event is visible only to its creator —
      // the app queries shared events and its own events separately, since
      // rules are not filters.
      match /events/{eventId} {
        function canSee() {
          return resource.data.private == false ||
            resource.data.createdBy == request.auth.uid;
        }

        allow read: if isMemberOf(coupleId) && canSee();
        allow create: if isMemberOf(coupleId) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.private is bool;
        // Either partner may edit a shared event; only the creator may
        // change who can see it. The creator never changes.
        allow update: if isMemberOf(coupleId) && canSee() &&
          request.resource.data.createdBy == resource.data.createdBy &&
          (request.resource.data.private == resource.data.private ||
           resource.data.createdBy == request.auth.uid);
        allow delete: if isMemberOf(coupleId) && canSee();
      }

      // Love notes. The envelope (sender, recipient, delivery time) is
      // visible to both, so a scheduled note can show "arrives in 3 days".
      match /notes/{noteId} {
        allow read: if isMemberOf(coupleId);
        allow create: if isMemberOf(coupleId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.recipientId != request.auth.uid &&
          request.resource.data.recipientId in
            get(coupleDoc(coupleId)).data.memberIds &&
          request.resource.data.openedAt == null;
        // The recipient marks it opened, once it has been delivered.
        allow update: if isMemberOf(coupleId) &&
          resource.data.recipientId == request.auth.uid &&
          changedKeys().hasOnly(['openedAt']) &&
          request.time >= resource.data.deliverAt;
        // The sender can unsend.
        allow delete: if isMemberOf(coupleId) &&
          resource.data.senderId == request.auth.uid;

        // The words: readable by the sender any time, and by the recipient
        // only from the delivery time. Written once, with the envelope.
        match /sealed/{docId} {
          function note() {
            return getAfter(/databases/$(database)/documents/couples/$(coupleId)/notes/$(noteId)).data;
          }

          allow get: if isMemberOf(coupleId) && (
            resource.data.senderId == request.auth.uid ||
            (resource.data.recipientId == request.auth.uid &&
             request.time >= resource.data.deliverAt)
          );
          allow list: if false;
          allow create: if isMemberOf(coupleId) && docId == 'content' &&
            note().senderId == request.auth.uid &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.recipientId == note().recipientId &&
            request.resource.data.deliverAt == note().deliverAt;
          allow update: if false;
          allow delete: if isMemberOf(coupleId) &&
            resource.data.senderId == request.auth.uid;
        }
      }

      // ---- Plans: date planner, bucket list, wishlist, places, expenses ----
      //
      // Shared planning lists. Either partner may add and edit; an item
      // stays credited to whoever added it. Field checks keep documents in
      // the shape the app reads.

      function str(field, maxLen) {
        return request.resource.data[field] is string &&
          request.resource.data[field].size() <= maxLen;
      }

      function title(field) {
        return str(field, 120) && request.resource.data[field].size() > 0;
      }

      function optStr(field, maxLen) {
        return !(field in request.resource.data) ||
          request.resource.data[field] == null || str(field, maxLen);
      }

      function optInt(field, minValue, maxValue) {
        return !(field in request.resource.data) ||
          request.resource.data[field] == null ||
          (request.resource.data[field] is int &&
           request.resource.data[field] >= minValue &&
           request.resource.data[field] <= maxValue);
      }

      function optTimestamp(field) {
        return !(field in request.resource.data) ||
          request.resource.data[field] == null ||
          request.resource.data[field] is timestamp;
      }

      // '' or an http(s) link.
      function optUrl(field) {
        return !(field in request.resource.data) ||
          request.resource.data[field] == null ||
          request.resource.data[field] == '' ||
          (str(field, 2000) &&
           request.resource.data[field].matches('(?i)^https?://.+'));
      }

      function isMember(uid) {
        return uid in get(coupleDoc(coupleId)).data.memberIds;
      }

      function createdByMe() {
        return request.resource.data.createdBy == request.auth.uid;
      }

      function creatorUnchanged() {
        return request.resource.data.createdBy == resource.data.createdBy;
      }

      match /datePlans/{planId} {
        function valid() {
          let d = request.resource.data;
          return title('title') && optStr('notes', 2000) &&
            optStr('location', 200) && optStr('reflection', 2000) &&
            d.status in ['idea', 'planned', 'done'] &&
            (d.status != 'planned' || d.scheduledAt is timestamp) &&
            optTimestamp('scheduledAt') && optTimestamp('completedAt') &&
            optInt('estimatedCostMinor', 0, 1000000000) &&
            optInt('rating', 1, 5) &&
            (!('vibe' in d) || d.vibe in
              ['cozy', 'adventure', 'fancy', 'outdoors', 'food', 'culture',
               'surprise']);
        }

        allow read: if isMemberOf(coupleId);
        allow create: if isMemberOf(coupleId) && createdByMe() && valid();
        allow update: if isMemberOf(coupleId) && creatorUnchanged() && valid();
        allow delete: if isMemberOf(coupleId);
      }

      match /bucketList/{itemId} {
        function valid() {
          let d = request.resource.data;
          return title('title') && optStr('notes', 2000) &&
            d.category in ['travel', 'adventure', 'food', 'learn', 'home',
                           'romance', 'other'] &&
            d.done is bool &&
            optTimestamp('doneAt') &&
            (!('doneBy' in d) || d.doneBy == null || isMember(d.doneBy)) &&
            optInt('targetYear', 2000, 2200);
        }

        allow read: if isMemberOf(coupleId);
        allow create: if isMemberOf(coupleId) && createdByMe() && valid();
        allow update: if isMemberOf(coupleId) && creatorUnchanged() && valid();
        allow delete: if isMemberOf(coupleId);
      }

      // Each wish belongs to the person who wants it; only they edit it.
      match /wishlist/{itemId} {
        function valid() {
          let d = request.resource.data;
          return title('title') && optStr('notes', 1000) && optUrl('url') &&
            optInt('priceMinor', 0, 1000000000) &&
            d.priority in ['love', 'like', 'someday'] &&
            (!('occasion' in d) ||
             d.occasion in ['any', 'birthday', 'anniversary', 'festival']) &&
            (!('received' in d) || d.received is bool);
        }

        allow read: if isMemberOf(coupleId);
        allow create: if isMemberOf(coupleId) && createdByMe() && valid();
        allow update: if isMemberOf(coupleId) &&
          resource.data.createdBy == request.auth.uid &&
          creatorUnchanged() && valid();
        allow delete: if isMemberOf(coupleId) &&
          resource.data.createdBy == request.auth.uid;
      }

      // "I'll get this": a secret claim on the partner's wish. Only the
      // claimer can ever read it, so the surprise survives. The app lists
      // claims with where('claimedBy', '==', uid), which these rules require.
      match /wishlistClaims/{itemId} {
        function wish() {
          return get(/databases/$(database)/documents/couples/$(coupleId)/wishlist/$(itemId)).data;
        }

        allow read: if isMemberOf(coupleId) &&
          resource.data.claimedBy == request.auth.uid;
        allow create: if isMemberOf(coupleId) &&
          request.resource.data.claimedBy == request.auth.uid &&
          request.resource.data.itemOwner == wish().createdBy &&
          request.resource.data.itemOwner != request.auth.uid &&
          request.resource.data.purchased is bool &&
          request.resource.data.keys().hasOnly(
            ['claimedBy', 'itemOwner', 'claimedAt', 'purchased']);
        allow update: if isMemberOf(coupleId) &&
          resource.data.claimedBy == request.auth.uid &&
          changedKeys().hasOnly(['purchased']) &&
          request.resource.data.purchased is bool;
        allow delete: if isMemberOf(coupleId) &&
          resource.data.claimedBy == request.auth.uid;
      }

      match /places/{placeId} {
        function valid() {
          let d = request.resource.data;
          return title('name') && optStr('area', 200) && optUrl('mapsUrl') &&
            optStr('notes', 2000) &&
            d.category in ['restaurant', 'cafe', 'bar', 'outdoors', 'travel',
                           'shopping', 'activity', 'other'] &&
            d.status in ['wantToGo', 'been'] &&
            optInt('rating', 1, 5) && optTimestamp('visitedAt') &&
            (!('favourite' in d) || d.favourite is bool);
        }

        allow read: if isMemberOf(coupleId);
        allow create: if isMemberOf(coupleId) && createdByMe() && valid();
        allow update: if isMemberOf(coupleId) && creatorUnchanged() && valid();
        allow delete: if isMemberOf(coupleId);
      }

      // Shared expenses, in integer minor units (paise). Either partner may
      // correct an entry; only whoever added it may delete it.
      match /expenses/{expenseId} {
        function valid() {
          let d = request.resource.data;
          return d.kind in ['expense', 'settlement'] &&
            title('title') && optStr('note', 500) &&
            d.amountMinor is int && d.amountMinor > 0 &&
            d.amountMinor <= 1000000000 &&
            isMember(d.paidBy) &&
            d.split in ['equal', 'full', 'custom'] &&
            (d.kind != 'settlement' || d.split == 'full') &&
            (d.split != 'custom' || d.shares is map) &&
            d.category in ['food', 'groceries', 'travel', 'home', 'bills',
                           'shopping', 'fun', 'gifts', 'other'] &&
            d.spentOn is timestamp;
        }

        allow read: if isMemberOf(coupleId);
        allow create: if isMemberOf(coupleId) && createdByMe() && valid();
        allow update: if isMemberOf(coupleId) && creatorUnchanged() && valid();
        allow delete: if isMemberOf(coupleId) &&
          resource.data.createdBy == request.auth.uid;
      }

      // ---- Chat look: colour and background both partners see ----------
      // Only `settings/chatLook` exists today. Either partner may change it.
      // A sign-in on a new phone waiting for the partner to confirm it's
      // really them (recycled-number protection). Only the OTHER partner
      // decides, once.
      match /deviceChecks/{checkId} {
        allow read: if isMemberOf(coupleId);
        allow create: if isMemberOf(coupleId) &&
          request.resource.data.keys().hasOnly(['uid', 'deviceId',
            'deviceName', 'createdAt', 'status', 'code']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.deviceId is string &&
          request.resource.data.deviceId.size() <= 64 &&
          request.resource.data.deviceName is string &&
          request.resource.data.deviceName.size() <= 60 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.status == 'pending' &&
          request.resource.data.code is int &&
          request.resource.data.code >= 10 && request.resource.data.code <= 99;
        allow update: if isMemberOf(coupleId) &&
          resource.data.uid != request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'decidedBy', 'decidedAt']) &&
          request.resource.data.status in ['approved', 'rejected'] &&
          request.resource.data.decidedBy == request.auth.uid &&
          request.resource.data.decidedAt == request.time;
        allow delete: if isMemberOf(coupleId) &&
          resource.data.uid == request.auth.uid;
      }

      // ---- Premium, gifts and Memory books --------------------------------
      // Gifts are created by the server when it verifies a gift purchase.
      // The partner it's for marks it opened, once.
      match /gifts/{giftId} {
        allow read: if isMemberOf(coupleId);
        allow create, delete: if false;
        allow update: if isMemberOf(coupleId) &&
          resource.data.toUid == request.auth.uid &&
          resource.data.get('openedAt', null) == null &&
          changedKeys().hasOnly(['openedAt']) &&
          request.resource.data.openedAt == request.time;
      }

      // A Memory book costs one credit: the same batch that creates it
      // takes one from the couple's bookCredits.
      match /books/{bookId} {
        allow read: if isMemberOf(coupleId);
        allow create: if isMemberOf(coupleId) &&
          request.resource.data.keys().hasOnly(['createdBy', 'title',
            'fromDate', 'toDate', 'pageCount', 'storagePath', 'createdAt']) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 80 &&
          request.resource.data.fromDate is timestamp &&
          request.resource.data.toDate is timestamp &&
          request.resource.data.fromDate <= request.resource.data.toDate &&
          request.resource.data.pageCount is int &&
          request.resource.data.pageCount > 0 &&
          request.resource.data.pageCount <= 500 &&
          request.resource.data.storagePath ==
            'couples/' + coupleId + '/books/' + bookId + '.pdf' &&
          request.resource.data.createdAt == request.time &&
          get(coupleDoc(coupleId)).data.get('bookCredits', 0) >= 1 &&
          getAfter(coupleDoc(coupleId)).data.get('bookCredits', 0) ==
            get(coupleDoc(coupleId)).data.get('bookCredits', 0) - 1;
        allow update: if isMemberOf(coupleId) &&
          resource.data.createdBy == request.auth.uid &&
          changedKeys().hasOnly(['title']) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 80;
        allow delete: if isMemberOf(coupleId);
      }

      // ---- Vault: end-to-end encrypted private space --------------------
      // Everything readable is encrypted on the phones (see
      // lib/features/vault). The server only ever sees ciphertext, device
      // public keys and wrapped keys, so these rules check shape and
      // membership; which phone may read the vault is decided by which
      // devices hold a wrapped key, approved on a partner's phone.
      // While a pairing is ending, the vault is closed for both: nothing
      // can be read or added, and the server wipes it with everything else.
      function separating() {
        return get(coupleDoc(coupleId)).data.get('separation', null) != null;
      }

      match /vault/{docId} {
        function validMeta() {
          let d = request.resource.data;
          return docId == 'meta' && d.version == 1 &&
            isMember(d.createdBy) &&
            d.devices is map && d.devices.size() <= 8 &&
            d.keys is map && d.keys.size() <= 8 &&
            d.verifier is string && d.verifier.size() <= 4000 &&
            d.updatedBy == request.auth.uid &&
            d.updatedAt == request.time;
        }

        allow read: if isMemberOf(coupleId) && !separating();
        allow create: if isMemberOf(coupleId) && !separating() && validMeta() &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isMemberOf(coupleId) && !separating() && validMeta() &&
          request.resource.data.createdBy == resource.data.createdBy;
        // "Delete vault for both".
        allow delete: if isMemberOf(coupleId) && !separating();
      }

      match /vaultItems/{itemId} {
        function vaultPath(field) {
          let v = request.resource.data.get(field, null);
          return v == null || (v is string && v.size() <= 200 &&
            v.matches('^couples/' + coupleId + '/vault/[^/]+$'));
        }

        function validItem() {
          let d = request.resource.data;
          return d.senderId == request.auth.uid &&
            d.kind in ['photo', 'message'] &&
            d.shelf in ['a', 'b'] &&
            d.ct is string && d.ct.size() > 0 && d.ct.size() <= 20000 &&
            vaultPath('photoPath') && vaultPath('thumbPath') &&
            d.policy in ['keep', 'once', 'day'] &&
            (d.policy == 'day'
              ? (d.expiresAt is timestamp &&
                 d.expiresAt > request.time &&
                 d.expiresAt < request.time + duration.value(25, 'h'))
              : d.get('expiresAt', null) == null) &&
            d.viewedBy is map && d.viewedBy.size() == 0 &&
            d.createdAt == request.time;
        }

        allow read: if isMemberOf(coupleId) && !separating();
        allow create: if isMemberOf(coupleId) && !separating() && validItem();
        // The only change is marking it seen, and only for yourself.
        allow update: if isMemberOf(coupleId) && !separating() &&
          changedKeys().hasOnly(['viewedBy']) &&
          request.resource.data.viewedBy.diff(resource.data.viewedBy)
            .affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.viewedBy[request.auth.uid] is timestamp;
        // Either partner may delete anything (view-once and expired items
        // are removed by whichever phone sees them first).
        allow delete: if isMemberOf(coupleId) && !separating();
      }

      match /vaultEvents/{eventId} {
        allow read: if isMemberOf(coupleId) && !separating();
        allow create: if isMemberOf(coupleId) && !separating() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.type in ['wrongCode', 'cooldown',
            'codeChanged', 'deviceAdded', 'deviceApproved', 'wiped'] &&
          request.resource.data.deviceName is string &&
          request.resource.data.deviceName.size() <= 60 &&
          request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if isMemberOf(coupleId) && !separating();
      }

      // ---- Music and Watch: saved links and shared sessions --------------
      // `songs` + `listening/now` (music) and `videos` + `watching/now`
      // (YouTube watch-together) share one shape and one set of checks.
      // Either partner may add, edit, love or delete an item. The link and
      // who added it never change; plays only ever go up by one.
      function mediaValid(sources, kinds) {
        let d = request.resource.data;
        return d.url is string && d.url.size() <= 2000 &&
          d.url.matches('^https://.+') &&
          d.source in sources && d.kind in kinds &&
          d.mediaId is string && d.mediaId.size() <= 64 &&
          optStr('title', 200) && optStr('artist', 200) &&
          optStr('note', 500) && optUrl('thumbnailUrl') &&
          d.moment is string && d.moment.size() <= 32 &&
          (!('lovedBy' in d) || (d.lovedBy is map &&
            d.lovedBy.keys().hasOnly(
              get(coupleDoc(coupleId)).data.memberIds))) &&
          optInt('playCount', 0, 1000000000) &&
          optTimestamp('lastPlayedAt');
      }

      function mediaCreateOk() {
        return isMemberOf(coupleId) &&
          request.resource.data.addedBy == request.auth.uid &&
          request.resource.data.get('playCount', 0) == 0;
      }

      function mediaUpdateOk() {
        return isMemberOf(coupleId) &&
          !changedKeys().hasAny(['url', 'source', 'kind', 'mediaId',
                                 'addedBy', 'createdAt']) &&
          (!('playCount' in changedKeys()) ||
           request.resource.data.playCount ==
             resource.data.get('playCount', 0) + 1);
      }

      // The one shared session (`listening/now` or `watching/now`). Every
      // playback change bumps `version` by exactly one (the app does it in a
      // transaction), so two phones can't silently overwrite each other.
      // Checking in touches only your own entry in `listeners`.
      function sessionValid(sources) {
        let d = request.resource.data;
        return d.songId is string && d.songId.size() > 0 &&
          d.songId.size() <= 64 &&
          d.url is string && d.url.size() <= 2000 &&
          d.url.matches('^https://.+') &&
          d.source in sources &&
          d.mediaId is string && d.mediaId.size() <= 64 &&
          optStr('title', 200) && optStr('artist', 200) &&
          optUrl('thumbnailUrl') &&
          d.status in ['countdown', 'playing', 'paused', 'ended'] &&
          d.positionMs is int && d.positionMs >= 0 &&
          d.at is int &&
          d.queue is list && d.queue.size() <= 50 &&
          d.hostUid in get(coupleDoc(coupleId)).data.memberIds &&
          d.listeners is map &&
          d.listeners.keys().hasOnly(
            get(coupleDoc(coupleId)).data.memberIds) &&
          d.version is int;
      }

      // Who changed playback, when (server time), and the next version.
      function playbackChange(previousVersion) {
        return request.resource.data.updatedBy == request.auth.uid &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.version == previousVersion + 1;
      }

      function checkInOnly() {
        return changedKeys().hasOnly(['listeners']) &&
          request.resource.data.listeners
            .diff(resource.data.listeners)
            .affectedKeys().hasOnly([request.auth.uid]);
      }

      // `<sessions>/clock-{uid}` lets a phone measure server time.
      function clockWriteOk(docId) {
        return docId == 'clock-' + request.auth.uid &&
          request.resource.data.keys().hasOnly(['t']) &&
          request.resource.data.t == request.time;
      }

      function allSources() {
        return ['spotify', 'youtube', 'youtubeMusic', 'appleMusic',
                'jioSaavn', 'soundCloud', 'other'];
      }

      function youtubeSources() {
        return ['youtube', 'youtubeMusic'];
      }

      match /songs/{songId} {
        function valid() {
          return mediaValid(allSources(),
                            ['track', 'video', 'album', 'playlist', 'other']) &&
            request.resource.data.moment in
              ['ourSong', 'romantic', 'missYou', 'happy', 'sad', 'roadTrip',
               'dance', 'chill', 'other'];
        }

        allow read: if isMemberOf(coupleId);
        allow create: if mediaCreateOk() && valid();
        allow update: if mediaUpdateOk() && valid();
        allow delete: if isMemberOf(coupleId);
      }

      // Videos to watch together: YouTube only, single videos only, so
      // both phones can play them in the app.
      match /videos/{videoId} {
        function valid() {
          return mediaValid(youtubeSources(), ['video']) &&
            request.resource.data.mediaId.size() > 0 &&
            request.resource.data.moment in
              ['movieNight', 'funny', 'romantic', 'food', 'travel', 'music',
               'learn', 'other'];
        }

        allow read: if isMemberOf(coupleId);
        allow create: if mediaCreateOk() && valid();
        allow update: if mediaUpdateOk() && valid();
        allow delete: if isMemberOf(coupleId);
      }

      match /listening/{docId} {
        allow read: if isMemberOf(coupleId) &&
          (docId == 'now' || docId == 'clock-' + request.auth.uid);
        allow create: if isMemberOf(coupleId) && (
          (docId == 'now' && sessionValid(allSources()) &&
           playbackChange(0)) ||
          clockWriteOk(docId));
        allow update: if isMemberOf(coupleId) && (
          (docId == 'now' && sessionValid(allSources()) &&
           (checkInOnly() || playbackChange(resource.data.version))) ||
          clockWriteOk(docId));
        allow delete: if false;
      }

      match /watching/{docId} {
        allow read: if isMemberOf(coupleId) &&
          (docId == 'now' || docId == 'clock-' + request.auth.uid);
        allow create: if isMemberOf(coupleId) && (
          (docId == 'now' && sessionValid(youtubeSources()) &&
           request.resource.data.mediaId.size() > 0 &&
           playbackChange(0)) ||
          clockWriteOk(docId));
        allow update: if isMemberOf(coupleId) && (
          (docId == 'now' && sessionValid(youtubeSources()) &&
           request.resource.data.mediaId.size() > 0 &&
           (checkInOnly() || playbackChange(resource.data.version))) ||
          clockWriteOk(docId));
        allow delete: if false;
      }

      match /settings/{docId} {
        function validLook() {
          let d = request.resource.data;
          return docId == 'chatLook' &&
            (d.color == null || d.color is int) &&
            d.background is map &&
            d.background.kind in ['none', 'pattern', 'photo'] &&
            (d.background.get('dim', 0) is number) &&
            d.background.get('dim', 0) >= 0 &&
            d.background.get('dim', 0) <= 0.7 &&
            (d.background.get('blur', 0) is number) &&
            d.background.get('blur', 0) >= 0 &&
            d.background.get('blur', 0) <= 12 &&
            (d.background.get('photoUrl', null) == null ||
             (d.background.photoUrl is string &&
              d.background.photoUrl.matches('^https://.+') &&
              d.background.photoUrl.size() <= 2000)) &&
            d.updatedBy == request.auth.uid;
        }

        allow read: if isMemberOf(coupleId);
        allow create, update: if isMemberOf(coupleId) && validLook();
        allow delete: if false;
      }

      // ---- Play: games between the two partners -------------------------
      //
      // One document per game. `turn` names whoever must act next, and only
      // they may change an active game; `moveCount` must go up by exactly
      // one per write, so two phones can't both apply a move. Finished and
      // cancelled games are frozen.
      match /games/{gameId} {
        function d() { return request.resource.data; }
        function r() { return resource.data; }
        function me() { return request.auth.uid; }

        function fixedKeysUnchanged() {
          return d().type == r().type && d().createdBy == r().createdBy &&
            d().invitee == r().invitee && d().players == r().players &&
            d().createdAt == r().createdAt;
        }

        // In the quiz, the guesses can't change once locked in, and the
        // person being guessed about never changes.
        function quizIntact() {
          return r().type != 'knowMe' || (
            (!('subject' in r().state) ||
              d().state.get('subject', null) == r().state.subject) &&
            (r().state.get('guessesLocked', false) != true ||
              (d().state.get('guessesLocked', false) == true &&
               d().state.get('guesses', null) == r().state.guesses))
          );
        }

        function cancelling() {
          return d().status == 'cancelled' && d().turn == null &&
            changedKeys().hasOnly(['status', 'turn', 'moveCount', 'updatedAt']);
        }

        function accepting() {
          return r().status == 'invited' && d().status == 'active' &&
            me() == r().invitee && d().turn in r().players &&
            d().winner == null;
        }

        function takingTurn() {
          return r().status == 'active' && me() == r().turn && (
            (d().status == 'active' && d().turn in r().players &&
             d().winner == null) ||
            (d().status == 'finished' && d().turn == null &&
             (d().winner == null || d().winner == 'draw' ||
              d().winner in r().players))
          );
        }

        allow read: if isMemberOf(coupleId);
        allow create: if isMemberOf(coupleId) &&
          d().type in ['knowMe', 'truthOrDare', 'ticTacToe', 'connectFour',
                       'ludo', 'snakesLadders'] &&
          d().createdBy == me() &&
          d().invitee != me() && isMember(d().invitee) &&
          d().players == [me(), d().invitee] &&
          d().status == 'invited' && d().turn == null &&
          d().winner == null && d().moveCount == 0 && d().state is map;
        allow update: if isMemberOf(coupleId) &&
          r().status in ['invited', 'active'] &&
          fixedKeysUnchanged() &&
          d().moveCount == r().moveCount + 1 &&
          d().state is map && quizIntact() &&
          (cancelling() || accepting() || takingTurn());
        allow delete: if false;

        // Quiz answers about yourself. Written once by the person being
        // guessed about, in the same batch that hands the turn over. The
        // guesser can read them only after locking in their guesses.
        match /secret/{docId} {
          function game() {
            return get(/databases/$(database)/documents/couples/$(coupleId)/games/$(gameId)).data;
          }

          allow get: if isMemberOf(coupleId) && (
            resource.data.subject == request.auth.uid ||
            game().state.get('guessesLocked', false) == true ||
            game().status == 'finished'
          );
          allow list: if false;
          allow create: if isMemberOf(coupleId) && docId == 'answers' &&
            game().type == 'knowMe' && game().status == 'active' &&
            game().turn == request.auth.uid &&
            game().state.get('subject', null) == request.auth.uid &&
            request.resource.data.subject == request.auth.uid &&
            request.resource.data.answers is list;
          allow update, delete: if false;
        }
      }

      // Thinking-of-you buzzes. Append-only.
      match /nudges/{nudgeId} {
        allow read: if isMemberOf(coupleId);
        allow create: if isMemberOf(coupleId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}

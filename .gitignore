# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing — never commit these
android/key.properties
**/*.jks
**/*.keystore

# Local backups and transfer archives
/_*.tar.gz
*.bak

# Local backups and archives (not part of the app)
_migration/
_claude_snapshot.tar.gz
*.tar.gz

# Server: installed packages and build output
server/node_modules/
server/dist/
# Firebase service-account keys used by the import script
server/scripts/*.json
!server/scripts/tsconfig.json
server/scripts/import.env
